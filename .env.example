# Backend API base URL (no trailing slash). Falls back to the old Render URL if unset.
VITE_API_BASE_URL=https://api-0ggv.onrender.com
# Socket.IO server (defaults to VITE_API_BASE_URL)
VITE_SOCKET_URL=
# Google sign-in needs no frontend variable: the client ID is read from GET /api/auth/config
# (set GOOGLE_SSO_CLIENT_ID on the backend).
